@startuml
title Konceptualni model — eFacilityTicketing

left to right direction
hide empty members
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor #333333
  ArrowColor #333333
  FontColor #222222
  HeaderBackgroundColor white
}

class Zgrada {
  id : Long
  naziv : String
  adresa : String
}

class Stan {
  id : Long
  broj : String
  sprat : int
}

class Korisnik {
  id : Long
  ime : String
  prezime : String
  email : String
  lozinka : String
  uloga : Uloga
}

class Tiket {
  id : Long
  naziv : String
  opis : String
  status : StatusTiketa
  prioritet : Prioritet
  datumKreiranja : LocalDateTime
  datumIzmene : LocalDateTime
}

class Komentar {
  id : Long
  poruka : String
  datumKreiranja : LocalDateTime
}

class IstorijaTiketa {
  id : Long
  prethodniStatus : StatusTiketa
  noviStatus : StatusTiketa
  datumPromene : LocalDateTime
}

Zgrada "1" *-- "0..*" Stan : sadrži
Stan "1" -- "0..*" Tiket : predmet prijave

Korisnik "1" -- "0..*" Tiket : stanar prijavljuje
Korisnik "0..1" -- "0..*" Tiket : menadžer zatvara
Korisnik "0..1" -- "0..*" Tiket : tehničar rešava

Tiket "1" *-- "0..*" Komentar : ima
Korisnik "1" -- "0..*" Komentar : ostavlja

Tiket "1" *-- "1..*" IstorijaTiketa : prati promene
Korisnik "1" -- "0..*" IstorijaTiketa : menja status

note right of Korisnik
Uloga:
TENANT
MANAGER
TECHNICIAN
end note

note bottom of Tiket
StatusTiketa:
OPEN → ASSIGNED → IN_PROGRESS
→ COMPLETED → CLOSED

Prioritet:
LOW, MEDIUM, HIGH, URGENT
end note
@enduml
